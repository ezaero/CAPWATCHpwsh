<#
.SYNOPSIS
    Escalates pilot invitations to all Orientation Pilots if slots aren't filled 24 hours after event creation.

.DESCRIPTION
    This function queries Cosmos DB for events created 24+ hours ago that still have unfilled pilot slots.
    Before sending escalation invitations, it expires all pending original invitations to prevent confusion.
    It then sends urgent escalation invitation emails to all qualified orientation pilots.
    Matches the email tone and format of the existing pilot invitation system with urgent messaging.

.PARAMETER CosmosEndpoint
    The Cosmos DB endpoint URL (e.g., "https://yourcosmosdb.documents.azure.com:443/")

.PARAMETER CosmosKey
    The Cosmos DB primary or secondary key

.PARAMETER DatabaseName
    The Cosmos DB database name (default: "OFlightCoordinator")

.PARAMETER TenantId
    Azure AD Tenant ID for Graph API authentication

.PARAMETER ClientId
    Azure AD Application (Client) ID for Graph API authentication

.PARAMETER ClientSecret
    Azure AD Application Client Secret for Graph API authentication

.PARAMETER EmailFromAddress
    The email address to send from (e.g., "noreply@cowg.cap.gov")

.PARAMETER DryRun
    If specified, logs what would be done without sending emails or updating database

.EXAMPLE
    Invoke-PilotInvitationEscalation `
        -CosmosEndpoint "https://yourdb.documents.azure.com:443/" `
        -CosmosKey "your-key-here" `
        -TenantId "your-tenant-id" `
        -ClientId "your-client-id" `
        -ClientSecret "your-secret" `
        -EmailFromAddress "noreply@cowg.cap.gov"

.EXAMPLE
    # Dry run to test without sending emails
    Invoke-PilotInvitationEscalation -DryRun `
        -CosmosEndpoint "https://yourdb.documents.azure.com:443/" `
        -CosmosKey "your-key-here"

.NOTES
    Author: Colorado Wing CAP
    Version: 1.0
    Requires: Az.CosmosDB, Microsoft.Graph modules
#>

function Invoke-PilotInvitationEscalation {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory = $true)]
        [string]$CosmosEndpoint,

        [Parameter(Mandatory = $true)]
        [string]$CosmosKey,

        [Parameter(Mandatory = $false)]
        [string]$DatabaseName = "OFlightCoordinator",

        [Parameter(Mandatory = $true)]
        [string]$TenantId,

        [Parameter(Mandatory = $true)]
        [string]$ClientId,

        [Parameter(Mandatory = $true)]
        [string]$ClientSecret,

        [Parameter(Mandatory = $true)]
        [string]$EmailFromAddress,

        [Parameter(Mandatory = $false)]
        [switch]$DryRun
    )

    begin {
        Write-Host "🚀 Starting Pilot Invitation Escalation Process..." -ForegroundColor Cyan
        Write-Host "   Cosmos Endpoint: $CosmosEndpoint" -ForegroundColor Gray
        Write-Host "   Database: $DatabaseName" -ForegroundColor Gray
        Write-Host "   Dry Run: $($DryRun.IsPresent)" -ForegroundColor Gray
        Write-Host ""

        # Initialize counters
        $stats = @{
            EventsChecked = 0
            EventsEligible = 0
            InvitationsExpired = 0
            InvitationsSent = 0
            Errors = 0
        }

        # Calculate 24 hours ago timestamp
        $escalationThreshold = (Get-Date).AddHours(-24).ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffZ")
        Write-Host "📅 Escalation threshold: Events created before $escalationThreshold" -ForegroundColor Yellow
        Write-Host ""
    }

    process {
        try {
            # ========================================
            # Step 1: Connect to Cosmos DB
            # ========================================
            Write-Host "📦 Connecting to Cosmos DB..." -ForegroundColor Cyan

            $cosmosContext = @{
                Endpoint = $CosmosEndpoint
                Key = $CosmosKey
                Database = $DatabaseName
            }

            # ========================================
            # Step 2: Query for events needing escalation
            # ========================================
            Write-Host "🔍 Querying events created 24+ hours ago with unfilled pilot slots..." -ForegroundColor Cyan

            $eventsQuery = @"
SELECT * FROM c
WHERE c.createdAt < '$escalationThreshold'
  AND c.status = 'scheduled'
  AND (IS_NULL(c.escalationStatus) OR c.escalationStatus.initialInvitationsSent = false OR NOT IS_DEFINED(c.escalationStatus.initialInvitationsSent))
  AND c.numberOfPilotsRequired > 0
ORDER BY c.createdAt ASC
"@

            $events = Invoke-CosmosDbQuery -Context $cosmosContext -Container "events" -Query $eventsQuery
            $stats.EventsChecked = $events.Count

            Write-Host "   Found $($events.Count) event(s) to check" -ForegroundColor Gray
            Write-Host ""

            if ($events.Count -eq 0) {
                Write-Host "✅ No events require escalation at this time." -ForegroundColor Green
                return
            }

            # ========================================
            # Step 3: Get all orientation pilots
            # ========================================
            Write-Host "👨‍✈️ Fetching all Orientation Pilots..." -ForegroundColor Cyan

            $pilotsQuery = 'SELECT * FROM c WHERE ARRAY_CONTAINS(c.roles, "pilot")'
            $allPilots = Invoke-CosmosDbQuery -Context $cosmosContext -Container "users" -Query $pilotsQuery

            Write-Host "   Found $($allPilots.Count) pilot(s) in database" -ForegroundColor Gray
            Write-Host ""

            # ========================================
            # Step 4: Connect to Microsoft Graph for emails
            # ========================================
            Write-Host "📧 Connecting to Microsoft Graph API..." -ForegroundColor Cyan

            $graphToken = Get-MsGraphToken -TenantId $TenantId -ClientId $ClientId -ClientSecret $ClientSecret

            Write-Host "   ✅ Graph token acquired" -ForegroundColor Gray
            Write-Host ""

            # ========================================
            # Step 5: Process each event
            # ========================================
            foreach ($event in $events) {
                Write-Host "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" -ForegroundColor DarkGray
                Write-Host "🎯 Processing Event: $($event.id)" -ForegroundColor Cyan
                Write-Host "   Airport: $($event.airport) | Date: $($event.date) | Time: $($event.time)" -ForegroundColor Gray
                Write-Host "   Created: $($event.createdAt)" -ForegroundColor Gray

                # Check pilot slots
                $pilotSlots = $event.pilotSlots
                $totalSlotsRequired = $event.numberOfPilotsRequired
                $filledSlots = ($pilotSlots | Where-Object { $null -ne $_.pilotId -and $_.pilotId -ne "" }).Count
                $unfilledSlots = $totalSlotsRequired - $filledSlots

                Write-Host "   Pilot Slots: $filledSlots / $totalSlotsRequired filled ($unfilledSlots unfilled)" -ForegroundColor Gray

                if ($unfilledSlots -le 0) {
                    Write-Host "   ✅ All pilot slots filled - skipping" -ForegroundColor Green
                    continue
                }

                $stats.EventsEligible++

                # Get pilots who were already invited to this event
                $existingInvitationsQuery = "SELECT c.pilotId FROM c WHERE c.eventId = '$($event.id)'"
                $existingInvitations = Invoke-CosmosDbQuery -Context $cosmosContext -Container "pilotInvitations" -Query $existingInvitationsQuery
                $alreadyInvitedPilotIds = $existingInvitations | ForEach-Object { $_.pilotId }

                Write-Host "   Already invited: $($alreadyInvitedPilotIds.Count) pilot(s)" -ForegroundColor Gray

                # Expire all pending invitations before sending escalation
                $pendingInvitationsQuery = "SELECT * FROM c WHERE c.eventId = '$($event.id)' AND c.status = 'pending'"
                $pendingInvitations = Invoke-CosmosDbQuery -Context $cosmosContext -Container "pilotInvitations" -Query $pendingInvitationsQuery

                if ($pendingInvitations.Count -gt 0) {
                    Write-Host "   ⏰ Expiring $($pendingInvitations.Count) pending invitation(s)..." -ForegroundColor Yellow

                    foreach ($invitation in $pendingInvitations) {
                        if (-not $DryRun) {
                            try {
                                $invitation.status = "expired"
                                $invitation.respondedAt = (Get-Date).ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffZ")
                                $invitation.expiryReason = "Event escalated to all pilots after 24 hours"

                                Update-CosmosDbDocument -Context $cosmosContext -Container "pilotInvitations" -Document $invitation -PartitionKeyValues @($event.id)

                                $stats.InvitationsExpired++
                                Write-Host "      ✅ Expired invitation for pilot: $($invitation.pilotName)" -ForegroundColor Gray
                            }
                            catch {
                                Write-Host "      ⚠️ Failed to expire invitation for $($invitation.pilotName): $($_.Exception.Message)" -ForegroundColor Yellow
                            }
                        }
                        else {
                            Write-Host "      [DRY RUN] Would expire invitation for: $($invitation.pilotName)" -ForegroundColor Yellow
                        }
                    }

                    Write-Host "   ✅ Pending invitations expired" -ForegroundColor Green
                }

                # Filter pilots: exclude those already assigned (still allow those who were previously invited since those are now expired)
                $assignedPilotIds = $pilotSlots | Where-Object { $null -ne $_.pilotId } | ForEach-Object { $_.pilotId }
                $eligiblePilots = $allPilots | Where-Object {
                    $_.id -notin $assignedPilotIds -and
                    $null -ne $_.email -and
                    $_.email -ne ""
                }

                Write-Host "   Eligible for escalation: $($eligiblePilots.Count) pilot(s)" -ForegroundColor Yellow

                if ($eligiblePilots.Count -eq 0) {
                    Write-Host "   ⚠️ No eligible pilots to invite" -ForegroundColor Yellow
                    continue
                }

                # Send invitation to each eligible pilot
                foreach ($pilot in $eligiblePilots) {
                    Write-Host "      📨 Sending escalation invitation to: $($pilot.name) ($($pilot.email))" -ForegroundColor White

                    if (-not $DryRun) {
                        try {
                            # Generate secure token
                            $token = New-SecureToken

                            # Create invitation record
                            $invitation = @{
                                id = (New-Guid).ToString()
                                eventId = $event.id
                                pilotId = $pilot.id
                                pilotEmail = $pilot.email
                                pilotName = $pilot.name
                                pilotCapid = $pilot.capid
                                pilotPhone = $pilot.phone
                                token = $token
                                status = "pending"
                                sentAt = (Get-Date).ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffZ")
                                expiresAt = (Get-Date).AddHours(48).ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffZ")
                                respondedAt = $null
                                isEscalation = $true
                                escalationType = "24h-post-creation"
                                createdAt = (Get-Date).ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffZ")
                            }

                            # Save invitation to Cosmos DB
                            Save-CosmosDbDocument -Context $cosmosContext -Container "pilotInvitations" -Document $invitation -PartitionKeyValue $event.id

                            # Send email
                            $emailParams = @{
                                Token = $graphToken
                                FromAddress = $EmailFromAddress
                                ToAddress = $pilot.email
                                PilotName = $pilot.name
                                Event = $event
                                InvitationToken = $token
                                ExpiryHours = 48
                                IsEscalation = $true
                            }
                            Send-PilotEscalationEmail @emailParams

                            $stats.InvitationsSent++
                            Write-Host "         ✅ Invitation sent and recorded" -ForegroundColor Green
                        }
                        catch {
                            $stats.Errors++
                            Write-Host "         ❌ Error: $($_.Exception.Message)" -ForegroundColor Red
                        }
                    }
                    else {
                        Write-Host "         [DRY RUN] Would send invitation" -ForegroundColor Yellow
                        $stats.InvitationsSent++
                    }
                }

                # Update event escalation status
                if (-not $DryRun) {
                    Write-Host "   📝 Updating event escalation status..." -ForegroundColor Cyan

                    if ($null -eq $event.escalationStatus) {
                        $event.escalationStatus = @{
                            initialInvitationsSent = $true
                            escalation24hSent = $false
                            escalation48hSent = $false
                            cancellationNotified = $false
                        }
                    }
                    else {
                        $event.escalationStatus.initialInvitationsSent = $true
                    }

                    $event.updatedAt = (Get-Date).ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss.fffZ")

                    Update-CosmosDbDocument -Context $cosmosContext -Container "events" -Document $event -PartitionKeyValues @($event.airport, $event.date)

                    Write-Host "   ✅ Event updated" -ForegroundColor Green
                }
                else {
                    Write-Host "   [DRY RUN] Would update event escalation status" -ForegroundColor Yellow
                }

                Write-Host ""
            }

        }
        catch {
            Write-Host "❌ Fatal error: $($_.Exception.Message)" -ForegroundColor Red
            Write-Host $_.ScriptStackTrace -ForegroundColor Red
            throw
        }
    }

    end {
        Write-Host "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" -ForegroundColor DarkGray
        Write-Host "📊 Escalation Summary" -ForegroundColor Cyan
        Write-Host "   Events Checked: $($stats.EventsChecked)" -ForegroundColor Gray
        Write-Host "   Events Eligible for Escalation: $($stats.EventsEligible)" -ForegroundColor Yellow
        Write-Host "   Original Invitations Expired: $($stats.InvitationsExpired)" -ForegroundColor Yellow
        Write-Host "   Escalation Invitations Sent: $($stats.InvitationsSent)" -ForegroundColor Green
        Write-Host "   Errors: $($stats.Errors)" -ForegroundColor $(if ($stats.Errors -gt 0) { "Red" } else { "Gray" })
        Write-Host ""
        Write-Host "✅ Pilot Invitation Escalation Process Complete!" -ForegroundColor Green
    }
}

