function Invoke-CosmosDbQuery {
    param(
        [Parameter(Mandatory = $true)]
        [hashtable]$Context,

        [Parameter(Mandatory = $true)]
        [string]$Container,

        [Parameter(Mandatory = $true)]
        [string]$Query
    )

    $uri = "$($Context.Endpoint)dbs/$($Context.Database)/colls/$Container/docs"
    $authHeader = Get-CosmosDbAuthHeader -Verb "POST" -ResourceType "docs" -ResourceLink "dbs/$($Context.Database)/colls/$Container" -Key $Context.Key

    $headers = @{
        "Authorization" = $authHeader
        "Content-Type" = "application/query+json"
        "x-ms-documentdb-isquery" = "True"
        "x-ms-version" = "2018-12-31"
        "x-ms-max-item-count" = "-1"
    }

    $body = @{
        query = $Query
    } | ConvertTo-Json -Depth 10

    try {
        $response = Invoke-RestMethod -Uri $uri -Method Post -Headers $headers -Body $body
        return $response.Documents
    }
    catch {
        Write-Host "❌ Cosmos DB Query Error: $($_.Exception.Message)" -ForegroundColor Red
        throw
    }
}

function Save-CosmosDbDocument {
    param(
        [Parameter(Mandatory = $true)]
        [hashtable]$Context,

        [Parameter(Mandatory = $true)]
        [string]$Container,

        [Parameter(Mandatory = $true)]
        [hashtable]$Document,

        [Parameter(Mandatory = $true)]
        [string]$PartitionKeyValue
    )

    $uri = "$($Context.Endpoint)dbs/$($Context.Database)/colls/$Container/docs"
    $authHeader = Get-CosmosDbAuthHeader -Verb "POST" -ResourceType "docs" -ResourceLink "dbs/$($Context.Database)/colls/$Container" -Key $Context.Key

    $headers = @{
        "Authorization" = $authHeader
        "Content-Type" = "application/json"
        "x-ms-version" = "2018-12-31"
        "x-ms-documentdb-partitionkey" = "[`"$PartitionKeyValue`"]"
    }

    $body = $Document | ConvertTo-Json -Depth 10

    try {
        $response = Invoke-RestMethod -Uri $uri -Method Post -Headers $headers -Body $body
        return $response
    }
    catch {
        Write-Host "❌ Cosmos DB Save Error: $($_.Exception.Message)" -ForegroundColor Red
        throw
    }
}

function Update-CosmosDbDocument {
    param(
        [Parameter(Mandatory = $true)]
        [hashtable]$Context,

        [Parameter(Mandatory = $true)]
        [string]$Container,

        [Parameter(Mandatory = $true)]
        [hashtable]$Document,

        [Parameter(Mandatory = $true)]
        [array]$PartitionKeyValues
    )

    $uri = "$($Context.Endpoint)dbs/$($Context.Database)/colls/$Container/docs/$($Document.id)"
    $authHeader = Get-CosmosDbAuthHeader -Verb "PUT" -ResourceType "docs" -ResourceLink "dbs/$($Context.Database)/colls/$Container/docs/$($Document.id)" -Key $Context.Key

    # Build hierarchical partition key
    $partitionKeyJson = ($PartitionKeyValues | ForEach-Object { "`"$_`"" }) -join ","

    $headers = @{
        "Authorization" = $authHeader
        "Content-Type" = "application/json"
        "x-ms-version" = "2018-12-31"
        "x-ms-documentdb-partitionkey" = "[$partitionKeyJson]"
    }

    $body = $Document | ConvertTo-Json -Depth 10

    try {
        $response = Invoke-RestMethod -Uri $uri -Method Put -Headers $headers -Body $body
        return $response
    }
    catch {
        Write-Host "❌ Cosmos DB Update Error: $($_.Exception.Message)" -ForegroundColor Red
        throw
    }
}

function Get-CosmosDbAuthHeader {
    param(
        [string]$Verb,
        [string]$ResourceType,
        [string]$ResourceLink,
        [string]$Key
    )

    $date = [DateTime]::UtcNow.ToString("R")
    $keyBytes = [Convert]::FromBase64String($Key)

    $text = @(
        $Verb.ToLowerInvariant(),
        $ResourceType.ToLowerInvariant(),
        $ResourceLink,
        $date.ToLowerInvariant(),
        ""
    ) -join "`n"

    $hmac = New-Object System.Security.Cryptography.HMACSHA256
    $hmac.Key = $keyBytes
    $hashBytes = $hmac.ComputeHash([Text.Encoding]::UTF8.GetBytes($text))
    $signature = [Convert]::ToBase64String($hashBytes)

    $authString = [System.Web.HttpUtility]::UrlEncode("type=master&ver=1.0&sig=$signature")

    return $authString
}

function Get-MsGraphToken {
    param(
        [string]$TenantId,
        [string]$ClientId,
        [string]$ClientSecret
    )

    $body = @{
        grant_type    = "client_credentials"
        client_id     = $ClientId
        client_secret = $ClientSecret
        scope         = "https://graph.microsoft.com/.default"
    }

    $uri = "https://login.microsoftonline.com/$TenantId/oauth2/v2.0/token"

    try {
        $response = Invoke-RestMethod -Uri $uri -Method Post -Body $body -ContentType "application/x-www-form-urlencoded"
        return $response.access_token
    }
    catch {
        Write-Host "❌ Graph Token Error: $($_.Exception.Message)" -ForegroundColor Red
        throw
    }
}

