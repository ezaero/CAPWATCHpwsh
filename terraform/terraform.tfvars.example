# Example terraform.tfvars file
# Copy this to terraform.tfvars and update with your wing's values

# Wing Configuration
wing_designator = "CO"  # Change to your wing's 2-letter code (TX, CA, FL, etc.)
location        = "East US"

# CAPWATCH Configuration
capwatch_org_id = "123"  # Your wing's CAPWATCH Organization ID

# CAPWATCH Credentials (sensitive - will be stored in Key Vault)
capwatch_username = "your-capwatch-username"
capwatch_password = "your-capwatch-password"

# Exchange Online Configuration
exchange_organization = "COCivilAirPatrol.onmicrosoft.com"  # Your wing's Exchange domain

# Timezone (optional - adjust for your wing's location)
timezone = "Mountain Standard Time"

# Email Configuration (optional)
log_email_to_address   = "admin@cowg.cap.gov"
log_email_from_address = "noreply@cowg.cap.gov"

# App Service Authentication / Easy Auth (optional)
# Leave blank when the Microsoft provider uses the Terraform-managed CAPWATCHSync app registration.
# If Authentication uses a separate app registration, set that app registration's object ID here
# before applying the managed-identity federation migration.
app_service_auth_application_object_id = ""

